    "dexie-react-hooks": "^1.1.7",
    "ts-fsrs": "^4.5.1",
    "framer-motion": "^11.11.1",
    "recharts": "^2.13.0",
    "react-hot-toast": "^2.4.1",
    "lucide-react": "^0.453.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
